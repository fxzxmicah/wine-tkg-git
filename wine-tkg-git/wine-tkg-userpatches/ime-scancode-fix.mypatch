diff --git a/dlls/imm32/ime.c b/dlls/imm32/ime.c
index c4d71856e68..c3995a4eab9 100644
--- a/dlls/imm32/ime.c
+++ b/dlls/imm32/ime.c
@@ -562,17 +562,18 @@ BOOL WINAPI ImeProcessKey( HIMC himc, UINT vkey, LPARAM lparam, BYTE *state )
     return ret;
 }
 
-UINT WINAPI ImeToAsciiEx( UINT vkey, UINT vsc, BYTE *state, TRANSMSGLIST *msgs, UINT flags, HIMC himc )
+UINT WINAPI ImeToAsciiEx( UINT vkey, LPARAM lparam, BYTE *state, TRANSMSGLIST *msgs, UINT flags, HIMC himc )
 {
     COMPOSITIONSTRING *compstr;
     UINT size, count = 0;
+    WORD vsc = HIWORD( lparam );
     INPUTCONTEXT *ctx;
     NTSTATUS status;
     BOOL key_consumed = TRUE;
     struct ime_driver_call_params params = {.himc = himc, .state = state};
 
-    TRACE( "vkey %#x, vsc %#x, state %p, msgs %p, flags %#x, himc %p\n",
-           vkey, vsc, state, msgs, flags, himc );
+    TRACE( "vkey %#x, lparam %#Ix, state %p, msgs %p, flags %#x, himc %p\n",
+           vkey, lparam, state, msgs, flags, himc );
 
     if (!is_ime_hkl( GetKeyboardLayout( 0 ) )) return 0;
 
@@ -590,7 +591,7 @@ UINT WINAPI ImeToAsciiEx( UINT vkey, UINT vsc, BYTE *state, TRANSMSGLIST *msgs,
 
         params.compstr = compstr;
         params.key_consumed = &key_consumed;
-        status = NtUserMessageCall( ctx->hWnd, WINE_IME_TO_ASCII_EX, vkey, vsc, &params,
+        status = NtUserMessageCall( ctx->hWnd, WINE_IME_TO_ASCII_EX, vkey, lparam, &params,
                                     NtUserImeDriverCall, FALSE );
         size = compstr->dwSize;
         params.state = NULL;
@@ -598,7 +599,7 @@ UINT WINAPI ImeToAsciiEx( UINT vkey, UINT vsc, BYTE *state, TRANSMSGLIST *msgs,
 
     if (status == STATUS_NOT_IMPLEMENTED)
     {
-        TRANSMSG msg = {.message = vsc & KF_UP ? WM_KEYUP : WM_KEYDOWN, .wParam = vkey, .lParam = vsc};
+        TRANSMSG msg = {.message = vsc & KF_UP ? WM_KEYUP : WM_KEYDOWN, .wParam = vkey, .lParam = lparam};
         msgs->TransMsg[count++] = msg;
     }
     else if (status) WARN( "WINE_IME_TO_ASCII_EX returned unexpected status %#lx\n", status );
@@ -636,7 +637,7 @@ UINT WINAPI ImeToAsciiEx( UINT vkey, UINT vsc, BYTE *state, TRANSMSGLIST *msgs,
 
         if (!key_consumed)
         {
-            TRANSMSG msg = {.message = WM_IME_KEYDOWN, .wParam = vkey, .lParam = vsc};
+            TRANSMSG msg = {.message = WM_IME_KEYDOWN, .wParam = vkey, .lParam = lparam};
             msgs->TransMsg[count++] = msg;
         }
     }
