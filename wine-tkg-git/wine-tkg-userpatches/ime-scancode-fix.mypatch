-static UINT WINAPI ime_ImeToAsciiEx( UINT vkey, UINT vsc, BYTE *state, TRANSMSGLIST *msgs, UINT flags, HIMC himc )
+static UINT WINAPI ime_ImeToAsciiEx( UINT vkey, LPARAM lparam, BYTE *state, TRANSMSGLIST *msgs, UINT flags, HIMC himc )
 {
+    WORD vsc = HIWORD( lparam );
     struct ime_call call =
     {
         .hkl = GetKeyboardLayout( 0 ), .himc = himc,
@@ -3508,8 +3509,8 @@ static UINT WINAPI ime_ImeToAsciiEx( UINT vkey, UINT vsc, BYTE *state, TRANSMSGL
     INPUTCONTEXT *ctx;
     UINT count = 0;
 
-    ime_trace( "vkey %#x, vsc %#x, state %p, msgs %p, flags %#x, himc %p\n",
-           vkey, vsc, state, msgs, flags, himc );
+    ime_trace( "vkey %#x, lparam %#Ix, state %p, msgs %p, flags %#x, himc %p\n",
+               vkey, lparam, state, msgs, flags, himc );
     ime_calls[ime_call_count++] = call;
 
     ok_ne( NULL, msgs, TRANSMSGLIST *, "%p" );
@@ -7643,6 +7644,7 @@ static void test_ga_na_da(void)
     INPUTCONTEXT *ctx;
     HWND hwnd;
     HIMC himc;
+    imm_msgs *ime_keydown_msg, *keydown_msg;
     UINT i;
 
     /* this test doesn't work on Win32 / WoW64 */
@@ -7814,10 +7816,25 @@ static void test_ga_na_da(void)
     process_messages();
     todo_wine ok_seq( partial_da_seq );
 
+    msg_spy_init( hwnd );
+    msg_spy_flush_msgs();
     todo_wine ok_ret( 2, ImmProcessKey( hwnd, default_hkl, VK_RETURN, MAKELONG(1, 0x1c), 0 ) );
     ok_ret( 0, ImmTranslateMessage( hwnd, WM_KEYDOWN, VK_RETURN, MAKELONG(1, 0x1c) ) );
     process_messages();
     todo_wine ok_seq( partial_return_seq );
+    for (i = 0, ime_keydown_msg = NULL; (ime_keydown_msg = msg_spy_find_next_msg( WM_IME_KEYDOWN, &i )); )
+        if (ime_keydown_msg->msg.wParam == VK_RETURN) break;
+    ok( !!ime_keydown_msg, "expected a generated WM_IME_KEYDOWN for VK_RETURN\n" );
+    if (ime_keydown_msg)
+        ok( ime_keydown_msg->msg.lParam == MAKELONG( 1, 0x1c ),
+            "got WM_IME_KEYDOWN lParam %#Ix\n", ime_keydown_msg->msg.lParam );
+    for (i = 0, keydown_msg = NULL; (keydown_msg = msg_spy_find_next_msg( WM_KEYDOWN, &i )); )
+        if (keydown_msg->msg.wParam == VK_RETURN) break;
+    ok( !!keydown_msg, "expected a reposted WM_KEYDOWN for VK_RETURN\n" );
+    if (keydown_msg)
+        ok( keydown_msg->msg.lParam == MAKELONG( 1, 0x1c ),
+            "got WM_KEYDOWN lParam %#Ix\n", keydown_msg->msg.lParam );
+    msg_spy_cleanup();
 
 
     /* cancelling clears the composition string */
